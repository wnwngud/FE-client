<?xml version="1.0" encoding="utf-8"?>
<ScrollView
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:fillViewport="true">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".ui.My_page.My_pageFragment"
    android:paddingTop="41dp">

    <TextView
        android:id="@+id/my_page_RePle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="관리자"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="20sp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/admin_main_icon"
        android:src="@drawable/ic_reple"
        android:layout_width="67dp"
        android:layout_height="67dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="50dp" />

    <TextView
        android:id="@+id/login_RePle_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/eco_green_dark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/admin_main_icon"
        android:layout_marginStart="0dp"
        android:text="Re:Ple" />

    <TextView
        android:id="@+id/login_RePle_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/eco_green_bright"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/login_RePle_1"
        android:layout_marginStart="0dp"
        android:text="Recycle People" />

    <TextView
        android:id="@+id/mission_set_title"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/login_RePle_2"
        app:layout_constraintStart_toStartOf="parent"

        android:text="미션 제목"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        />

    <EditText
        android:id="@+id/input_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="미션 제목을 입력해 주세요."
        android:background="@drawable/admin_mission_edittext_border_white"
        app:layout_constraintTop_toBottomOf="@id/mission_set_title"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="8dp"
        android:textColorHint="#AFAFAF"
        android:textSize="14sp"
        android:padding="10dp"/>

    <TextView
        android:id="@+id/mission_set_type"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/input_title"
        app:layout_constraintStart_toStartOf="parent"

        android:text="미션 종류"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        />


    <LinearLayout
        android:id="@+id/mission_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/mission_set_type"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/type_always"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/admin_misson_smallbutton"
            android:text="상시"
            android:textSize="9sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_marginRight="10dp"/>

        <Button
            android:id="@+id/type_sudden"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/admin_misson_smallbutton"
            android:text="돌발"
            android:textSize="9sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:minWidth="0dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/mission_set_category"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/mission_type"
        app:layout_constraintStart_toStartOf="parent"

        android:text="미션 카테고리"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        />

    <LinearLayout
        android:id="@+id/mission_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/mission_set_category"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/category_tumbler"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/admin_misson_smallbutton"
            android:text="텀블러"
            android:textSize="9sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_marginRight="10dp"/>

        <Button
            android:id="@+id/category_traffiic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/admin_misson_smallbutton"
            android:text="대중교통"
            android:textSize="9sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_marginRight="10dp"/>

        <Button
            android:id="@+id/category_recycle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/admin_misson_smallbutton"
            android:text="재활용"
            android:textSize="9sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:minWidth="0dp"/>

    </LinearLayout>


    <TextView
        android:id="@+id/mission_set_period"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/mission_category"
        app:layout_constraintStart_toStartOf="parent"

        android:text="미션 기간"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        />

    <EditText
        android:id="@+id/input_period1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="미션 시작일"
        android:background="@drawable/admin_mission_edittext_border_white"
        app:layout_constraintTop_toBottomOf="@id/mission_set_period"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="8dp"
        android:textColorHint="#AFAFAF"
        android:textSize="14sp"
        android:padding="8dp"/>

    <TextView
        android:id="@+id/period_text"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        app:layout_constraintStart_toEndOf="@id/input_period1"
        app:layout_constraintBottom_toBottomOf="@id/input_period1"
        app:layout_constraintTop_toTopOf="@id/input_period1"
        android:layout_marginLeft = "5dp"
        android:text="~" />

    <EditText
        android:id="@+id/input_period2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="미션 시작일"
        android:background="@drawable/admin_mission_edittext_border_white"
        app:layout_constraintTop_toBottomOf="@id/mission_set_period"
        app:layout_constraintStart_toEndOf="@id/period_text"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="8dp"
        android:textColorHint="#AFAFAF"
        android:textSize="14sp"
        android:padding="8dp"/>

    <TextView
        android:id="@+id/mission_set_point"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/input_period1"
        app:layout_constraintStart_toStartOf="parent"

        android:text="지급 포인트"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        />

    <EditText
        android:id="@+id/input_point"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/admin_mission_edittext_border_white"
        app:layout_constraintTop_toBottomOf="@id/mission_set_point"
        app:layout_constraintStart_toStartOf="parent"
        android:inputType="numberDecimal"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="8dp"
        android:hint="지급할 포인트"
        android:textColorHint="#AFAFAF"
        android:textSize="14sp"
        android:padding="8dp"/>

    <TextView
        android:id="@+id/point_text"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        app:layout_constraintStart_toEndOf="@id/input_point"
        app:layout_constraintBottom_toBottomOf="@id/input_point"
        app:layout_constraintTop_toTopOf="@id/input_point"
        android:layout_marginLeft = "5dp"
        android:text="p" />

    <TextView
        android:id="@+id/mission_set_description"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/input_point"
        app:layout_constraintStart_toStartOf="parent"

        android:text="미션 설명"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        />

    <EditText
        android:id="@+id/input_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="미션 설명을 입력해 주세요."
        android:background="@drawable/admin_mission_edittext_border_white"
        app:layout_constraintTop_toBottomOf="@id/mission_set_description"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="8dp"
        android:textColorHint="#AFAFAF"
        android:textSize="14sp"
        android:padding="10dp"
        android:inputType="textMultiLine"
        android:gravity="top|start"
        android:minLines="5"
        android:scrollbars="vertical"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/input_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/always_mission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/admin_mission_edittext_border_white"
            android:text="미리보기"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:layout_marginRight="50dp"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/sudden_mission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/admin_mission_button_gray"
            android:text="업로드"
            android:textColor="#000000"
            android:textStyle="bold"
            android:minHeight="0dp"/>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
